<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Orleans" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LoginServer/LoginServer.csproj" />
    <ProjectReference Include="../WorldServer/Athena.World/Athena.World.csproj" />
  </ItemGroup>
</Project>
