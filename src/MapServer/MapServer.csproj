<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Athena.Net.MapServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Generated/World/MapData/AthenaMaps.bin" Link="MapData/AthenaMaps.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Embed source revision for runtime build provenance. -->
  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevisionExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitRevisionExitCode)' != '0' Or '$(SourceRevisionId)' == ''">
      <SourceRevisionId>unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
