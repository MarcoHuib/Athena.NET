<Window x:Class="Athena.Net.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Athena.NET Launcher" Height="680" Width="1040" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0B1020">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101C38" Offset="0"/><GradientStop Color="#25153E" Offset="0.55"/><GradientStop Color="#07101F" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Ellipse Width="520" Height="520" Fill="#182E8DFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-230,-100,0"/>
    <Grid Margin="72,52">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
        <TextBlock Text="A T H E N A . N E T" FontSize="17" FontWeight="SemiBold" Foreground="#78BEFF"/>
        <TextBlock Text="Return to Midgard." FontSize="52" FontWeight="Bold" Margin="0,14,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="Official iRO client. Official updater. Easy Anti-Cheat enabled. Athena handles the connection while you play—and leaves no proxy behind." FontSize="18" LineHeight="29" Foreground="#B9C7DF" TextWrapping="Wrap"/>
        <Border Background="#223047" CornerRadius="12" Margin="0,34,0,0" Padding="18">
          <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#62E6A5" Margin="0,0,12,0"/><TextBlock Text="{Binding Status}" FontSize="15" VerticalAlignment="Center"/></StackPanel>
        </Border>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#354864" BorderThickness="1" CornerRadius="20" Padding="32">
        <StackPanel>
          <TextBlock Text="RAGNAROK CLIENT" Foreground="#8293AE" FontSize="12" FontWeight="Bold"/>
          <TextBlock Text="Update &amp; connect" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,28"/>
          <TextBlock Text="OFFICIAL LOGIN" Foreground="#8293AE" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="{Binding OfficialEndpoint}" FontSize="16" Margin="0,6,0,22"/>
          <TextBlock Text="ATHENA.NET" Foreground="#8293AE" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="{Binding AthenaEndpoint}" FontSize="16" Margin="0,6,0,22"/>
          <TextBlock Text="LOCAL PROXIES" Foreground="#8293AE" FontSize="11" FontWeight="Bold"/>
          <Grid Margin="0,10,0,30">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock><Run Text="Login · "/><Run Text="{Binding ProxyStatus}"/></TextBlock><TextBlock Grid.Column="1"><Run Text="Character · "/><Run Text="{Binding ProxyStatus}"/></TextBlock><TextBlock Grid.Column="2"><Run Text="Map · "/><Run Text="{Binding ProxyStatus}"/></TextBlock>
          </Grid>
          <Button Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Height="58" Background="#368DFF" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="15" Cursor="Hand">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="18"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            UPDATE &amp; PLAY
          </Button>
          <TextBlock Text="Windows will ask for administrator access once. Athena only uses it for temporary ActiveStore IP aliases." FontSize="12" Foreground="#8293AE" TextWrapping="Wrap" LineHeight="18" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
