<Application x:Class="Athena.Net.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#D91A2033" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6DB7FF" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF4FF" /></Style>
  </Application.Resources>
</Application>
