<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Athena.Launcher</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Athena.Launcher.Core/Athena.Launcher.Core.csproj" />
    <ProjectReference Include="../Athena.Launcher.Networking/Athena.Launcher.Networking.csproj" />
    <ProjectReference Include="../Athena.Launcher.Watchdog/Athena.Launcher.Watchdog.csproj" ReferenceOutputAssembly="false" />
    <None Include="launcher.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
